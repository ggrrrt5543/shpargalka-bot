# Telegram Bot
TELEGRAM_TOKEN=<токен_от_BotFather>

# Qwen API
QWEN_API_URL=https://qwen.aikit.club
QWEN_TOKEN=<ваш_jwt_токен>
QWEN_API_KEY=<алиас_QWEN_TOKEN_если_клиент_требует_отдельно>

# Mini App backend (FastAPI на Fly.io)
MINI_APP_BASE_URL=https://shpargalka-app-mjhceaka.fly.dev
MINI_APP_API_KEY=<ваш_api_ключ>

# Имена моделей
TEXT_MODEL=qwen3.6-plus
VERIFIER_MODEL=qwen3.6-max-preview
VISION_MODEL=qwen3.6-plus

# ─── RAG (база знаний) ───────────────────────────────────────────────────────
KNOWLEDGE_BASE_PATH=./knowledge_base
EMBEDDING_MODEL=text-embedding-3-small

# ─── Память диалога ──────────────────────────────────────────────────────────
MAX_HISTORY_MESSAGES=10
HISTORY_TIMEOUT_MINUTES=30

# ─── Кэш ─────────────────────────────────────────────────────────────────────
CACHE_TTL_HOURS=24

# ─── Админ ───────────────────────────────────────────────────────────────────
# Telegram user_id админов (через запятую)
ADMIN_IDS=123456789
# Секретная фраза для входа в админ-панель (без /)
ADMIN_SECRET_PHRASE=открой ворота
# Пароль (второй этап авторизации)
ADMIN_PASSWORD=<ваш_пароль>
