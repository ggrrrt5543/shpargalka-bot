# Telegram Bot
TELEGRAM_TOKEN=<токен_от_BotFather>

# Qwen API
QWEN_API_URL=https://qwen.aikit.club
QWEN_TOKEN=<ваш_jwt_токен>
QWEN_API_KEY=<алиас_QWEN_TOKEN_если_клиент_требует_отдельно>

# Mini App backend (FastAPI на Fly.io)
MINI_APP_BASE_URL=https://shpargalka-app-mjhceaka.fly.dev
MINI_APP_API_KEY=<ваш_api_ключ>

# Имена моделей. qwen3.6-plus — флагман с vision, qwen3.6-max-preview —
# лучший reasoning. Полный список: GET https://qwen.aikit.club/models
TEXT_MODEL=qwen3.6-plus
VERIFIER_MODEL=qwen3.6-max-preview
VISION_MODEL=qwen3.6-plus
